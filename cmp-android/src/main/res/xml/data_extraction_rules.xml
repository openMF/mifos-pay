<!--
    Backup/transfer policy for Android 12+ (API 31+). Mifos Pay stores tokens,
    credentials and account data locally, so no user data must ever leave the
    device through Auto Backup or device-to-device migration. Every backup domain
    is excluded from both cloud backup and device transfer. For Android 11 and
    lower the same intent is expressed via android:fullBackupContent="false" and
    android:allowBackup="false" in AndroidManifest.xml (MW-SEC-015).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
