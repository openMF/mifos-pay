// Fork identity — generated by ./gradlew syncForkConfig
// To change: edit gradle/fork.properties (or libs.versions.toml for app.id),
// then re-run ./gradlew syncForkConfig
APP_BUNDLE_ID = org.mifospay
APP_NAME = Mifos Pay
TEAM_ID = L432S2FZP5

// Keychain Sharing entitlement — REQUIRED by core-base/datastore's KeychainSettings
// (service "kpt.secure"). Without it iOS keychain access fails -34018 at launch and
// crashes the Koin graph (UserPreferencesRepositoryImpl -> AppViewModel). Applies to
// every flavor (project-level base config). Path relative to cmp-ios/ (SRCROOT).
CODE_SIGN_ENTITLEMENTS = iosApp/iosApp.entitlements
