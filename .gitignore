# iOS — Xcode
# Per-user Xcode state (breakpoints, window positions, UI state, scheme
# selections) — never commit, it's per-developer and leaks personal data
# (macOS username) into every fork.
**/xcuserdata/
*.xcuserstate
# SwiftPM artifacts.
#
# `cmp-ios/KotlinMultiplatformLinkedPackage/` is TRACKED and must stay tracked: iosApp.xcodeproj
# declares it as an XCLocalSwiftPackageReference (relativePath = KotlinMultiplatformLinkedPackage),
# and `xcodebuild` resolves package dependencies BEFORE the Gradle build phase that would emit it —
# so on a fresh checkout the Package.swift + subpackage stubs must already be on disk or the build
# dies with "the package at '.../KotlinMultiplatformLinkedPackage' cannot be accessed".
#
# Only the RESOLVED artifacts below are ignored — they are the ~1.2 GB (dependency checkouts +
# SwiftPM index store) that a `git add -A` in a fork would otherwise stage as ~20k files and a
# >100 MB pack GitHub rejects.
cmp-ios/.build/
cmp-ios/KotlinMultiplatformLinkedPackage/.build/
cmp-ios/KotlinMultiplatformLinkedPackage/Package.resolved

# Eclipse project files
.classpath
.project

# Windows thumbnail db
.DS_Store

# IDEA/Android Studio project files, because
# the project can be imported from settings.gradle.kts
*.iml
.idea/*
!.idea/copyright
